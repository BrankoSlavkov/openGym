{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "allowJs": false,
    "strict": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
