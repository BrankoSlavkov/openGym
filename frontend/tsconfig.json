{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite-plus/client",
      "node"
    ]
  },
  "include": [
    "src",
    "web-only",
    "vite.config.ts",
    "orval.config.ts"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/test-setup.js"
  ]
}
