{
  "name": "opengym-frontend",
  "private": true,
  "version": "1.4.5",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "node scripts/api-client.mjs && vp check",
    "typecheck": "node scripts/api-client.mjs && tsc -p .",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "pdf:check": "node scripts/pdf/render-samples.mjs --out pdf-samples --langs en --paper A4,Letter --check",
    "api:generate": "orval --config orval.config.ts",
    "typecheck:tests": "node scripts/api-client.mjs && tsc -p tsconfig.test.json"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0",
    "orval": "8.48.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "lightningcss": "1.33.0",
    "linkedom": "0.18.15",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  }
}
